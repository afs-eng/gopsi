DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=gopsi.onrender.com
CSRF_TRUSTED_ORIGINS=https://gopsi.vercel.app
CORS_ALLOWED_ORIGINS=https://gopsi.vercel.app
CORS_ALLOWED_ORIGIN_REGEXES=^https://.*-afs-eng.vercel.app$
DATABASE_URL=postgresql://postgres.PROJECT_REF:replace-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# POSTGRES_* só é necessário para docker-compose.prod.yml com Postgres local.
POSTGRES_DB=plataforma_psi
POSTGRES_USER=plataforma_psi
POSTGRES_PASSWORD=replace-password
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
NEXT_PUBLIC_API_BASE_URL=https://gopsi.onrender.com
FRONTEND_BASE_URL=https://gopsi.vercel.app
DEFAULT_FROM_EMAIL=no-reply@gopsi.com.br
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-brevo-smtp-login
EMAIL_HOST_PASSWORD=replace-with-brevo-smtp-key
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DRF_ANON_THROTTLE_RATE=60/min
DRF_USER_THROTTLE_RATE=1000/hour
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
LOG_LEVEL=INFO
MFA_ISSUER=Plataforma PSI
DAILY_API_KEY=
DAILY_API_BASE_URL=https://api.daily.co/v1
DAILY_ROOM_DURATION_MINUTES=180
RUN_MIGRATIONS=false
RUN_COLLECTSTATIC=true
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
